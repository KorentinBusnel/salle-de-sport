# =============================================================================
# Variables d'environnement de la plateforme — RÉFÉRENCE, sans aucune valeur réelle.
#
# Ce fichier documente TOUTES les variables lues par le code (vérifié par `pnpm env:check`).
# Les valeurs réelles ne sont jamais commitées. Elles vont :
#   - en local : dans apps/backoffice/.env.local et apps/mobile/.env.local (`pnpm env:local`) ;
#   - en session cloud Claude Code : configuration de l'environnement (variables) ;
#   - sur Vercel (back office), EAS (app mobile), `supabase secrets set` (Edge Functions),
#     GitHub Actions (secrets du dépôt).
#
# Règle : seules les variables NEXT_PUBLIC_* et EXPO_PUBLIC_* atteignent le navigateur ou l'app.
# Elles ne contiennent que l'URL Supabase et la clé anon, filtrées par la RLS.
# =============================================================================

# -----------------------------------------------------------------------------
# Back office (apps/backoffice) — publiques
# -----------------------------------------------------------------------------
# Local : http://127.0.0.1:54321 et la clé anon de `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# App mobile (apps/mobile) — publiques, embarquées dans l'app
# -----------------------------------------------------------------------------
# Sur un téléphone physique en local, remplacer 127.0.0.1 par l'IP de la machine de dev.
# Pour EAS Update (Expo Go), ce sont des variables EAS de l'environnement `preview`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Outillage — session cloud et CI uniquement, jamais dans une app
# -----------------------------------------------------------------------------
# Jeton de compte Supabase (Account → Access Tokens) : déploiement du projet de dev.
SUPABASE_ACCESS_TOKEN=
# Identifiant du projet Supabase de dev en ligne (Project Settings → Reference ID).
SUPABASE_DEV_PROJECT_REF=
# Mot de passe Postgres du projet de dev.
SUPABASE_DEV_DB_PASSWORD=
# Jeton Expo (expo.dev → Account settings → Access tokens) : EAS Build et EAS Update.
EXPO_TOKEN=

# -----------------------------------------------------------------------------
# Serveur uniquement (Edge Functions, routes serveur Next.js) — phases suivantes
# Noms prévus : à confirmer lors de l'implémentation de chaque phase.
# -----------------------------------------------------------------------------
# Phase 1+ — accès administrateur à la base, contourne la RLS. Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=
# Fournies par Supabase aux Edge Functions (rien à renseigner) : URL du projet et clé anon.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Phase 2 — Stripe (mode test pendant tout le développement).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tests des Edge Functions uniquement : URL de stripe-mock (ex. http://localhost:12111).
STRIPE_API_BASE=
# Clé publiable Stripe (publique) pour Payment Sheet / Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 2/3 — emails transactionnels (Resend).
RESEND_API_KEY=

# Optionnel — Sentry (DSN publics, jeton d'upload des sourcemaps côté CI).
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Hub 360° : assistant Claude (serveur Next.js uniquement, jamais NEXT_PUBLIC_).
ANTHROPIC_API_KEY=
# Modèle de l'assistant (défaut : claude-sonnet-5-5).
ANTHROPIC_MODEL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PENNYLANE_API_KEY=
