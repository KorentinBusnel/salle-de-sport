# =============================================================================
# Variables d'environnement de la plateforme — RÉFÉRENCE, sans aucune valeur réelle.
#
# Ce fichier documente TOUTES les variables lues par le code (vérifié par `pnpm env:check`).
# Les valeurs réelles ne sont jamais commitées. Elles vont :
#   - en local : dans les .env.local de apps/backoffice, apps/site et apps/mobile
#     (`pnpm env:local`) ;
#   - en session cloud Claude Code : configuration de l'environnement (variables) ;
#   - sur Vercel (back office, site vitrine), EAS (app mobile), `supabase secrets set` (Edge Functions),
#     GitHub Actions (secrets du dépôt).
#
# Règle : seules les variables NEXT_PUBLIC_* et EXPO_PUBLIC_* atteignent le navigateur ou l'app.
# Elles ne contiennent que l'URL Supabase et la clé anon, filtrées par la RLS.
# =============================================================================

# -----------------------------------------------------------------------------
# Back office (apps/backoffice) et site vitrine (apps/site) — publiques
# -----------------------------------------------------------------------------
# Local : http://127.0.0.1:54321 et la clé anon de `supabase status`. Le site ne s'en sert que
# côté serveur, pour le formulaire de démo (request_demo) ; sans elles, il se construit quand même.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Site vitrine (apps/site)
# -----------------------------------------------------------------------------
# Adresse publique du site (métadonnées, image de partage, sitemap, llms.txt). Facultative : à
# défaut, le domaine de production fourni par Vercel, sinon l'adresse du déploiement, sinon
# http://localhost:3001. À poser quand le site a son propre domaine, si Vercel ne le choisit pas.
NEXT_PUBLIC_SITE_URL=
# Fourni par Vercel (production, preview, development) : le site n'est indexé qu'en production.
VERCEL_ENV=
# Fournis par Vercel : domaine de production du projet et adresse du déploiement en cours.
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_URL=

# -----------------------------------------------------------------------------
# Site vitrine (apps/site) — secrètes, côté serveur uniquement
# -----------------------------------------------------------------------------
# Alerte email de chaque nouvelle demande de démo, envoyée par Resend (resend.com) après la
# réponse au visiteur. Sans RESEND_API_KEY ou DEMO_NOTIFY_EMAIL, aucune alerte n'est envoyée.
RESEND_API_KEY=
# Destinataire de l'alerte (l'équipe).
DEMO_NOTIFY_EMAIL=
# Expéditeur. Défaut : « Chalq <onboarding@resend.dev> », accepté par Resend sans domaine vérifié
# tant que le destinataire est l'adresse du compte Resend.
DEMO_NOTIFY_FROM=

# -----------------------------------------------------------------------------
# App mobile (apps/mobile) — publiques, embarquées dans l'app
# -----------------------------------------------------------------------------
# Sur un téléphone physique en local, remplacer 127.0.0.1 par l'IP de la machine de dev.
# Pour EAS Update (Expo Go), ce sont des variables EAS de l'environnement `preview`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Outillage — session cloud et CI uniquement, jamais dans une app
# -----------------------------------------------------------------------------
# Jeton de compte Supabase (Account → Access Tokens) : déploiement du projet de dev.
SUPABASE_ACCESS_TOKEN=
# Identifiant du projet Supabase de dev en ligne (Project Settings → Reference ID).
SUPABASE_DEV_PROJECT_REF=
# Mot de passe Postgres du projet de dev.
SUPABASE_DEV_DB_PASSWORD=
# Jeton Expo (expo.dev → Account settings → Access tokens) : EAS Build et EAS Update.
EXPO_TOKEN=

# -----------------------------------------------------------------------------
# Serveur uniquement (Edge Functions, routes serveur Next.js) — phases suivantes
# Noms prévus : à confirmer lors de l'implémentation de chaque phase.
# -----------------------------------------------------------------------------
# Phase 1+ — accès administrateur à la base, contourne la RLS. Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=
# Fournies par Supabase aux Edge Functions (rien à renseigner) : URL du projet et clé anon.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Phase 2 — Stripe (mode test pendant tout le développement).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tests des Edge Functions uniquement : URL de stripe-mock (ex. http://localhost:12111).
STRIPE_API_BASE=
# Clé publiable Stripe (publique) pour Payment Sheet / Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 2/3 — emails transactionnels (Resend).
RESEND_API_KEY=

# Optionnel — Sentry (DSN publics, jeton d'upload des sourcemaps côté CI).
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Hub 360° : assistant Claude (serveur Next.js uniquement, jamais NEXT_PUBLIC_).
ANTHROPIC_API_KEY=
# Modèle de l'assistant (défaut : claude-sonnet-5-5).
ANTHROPIC_MODEL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
PENNYLANE_API_KEY=
