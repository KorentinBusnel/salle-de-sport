# App mobile — variables publiques (embarquées dans l'app, jamais de secret ici).
# En local : `pnpm env:local` les remplit depuis `supabase status`.
# Sur un téléphone physique, remplacer 127.0.0.1 par l'adresse IP de la machine de dev.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
