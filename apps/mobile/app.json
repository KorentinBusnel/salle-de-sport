{
  "expo": {
    "name": "Salle de sport",
    "slug": "salle-de-sport",
    "scheme": "salledesport",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
